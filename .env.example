# =====================================================================
# CarsHub — EXEMPLO das variáveis de ambiente do backend
# =====================================================================
# Copie este arquivo para .env (fora do git) e preencha os valores reais:
#   Copy-Item .env.example .env
#
# O docker compose carrega o .env automaticamente e injeta todas as
# variáveis no container do backend (env_file). Para rodar o backend
# pela IDE/terminal, exporte as variáveis na sessão do PowerShell ou na
# configuração de execução do IntelliJ:
#   $env:MAIL_PASSWORD = "sua-senha-de-app"
#   $env:JWT_SEGREDO    = "segredo-aleatorio-com-32-caracteres-ou-mais"
#   $env:GOOGLE_MAPS_API_KEY = "sua-chave"
#
# O application.yaml apenas REFERENCIA estas variáveis — nenhum segredo
# pode ser hardcoded lá (sem fallback). A aplicação NÃO inicia sem elas.
#
# ⚠️ A senha de app do Gmail que circulou pelo git deve ser considerada
# comprometida — gere uma NOVA senha de app em
# https://myaccount.google.com/apppasswords.

# ---- Banco de dados (localhost:3307 via docker compose) ----
DB_USERNAME=root
DB_PASSWORD=root
MYSQL_ROOT_PASSWORD=root

# ---- E-mail (Gmail/SMTP) ----
MAIL_USERNAME=plataformacarshub@gmail.com
MAIL_PASSWORD=

# ---- JWT (11.1) — segredo com 32+ caracteres (HS256) ----
# Gere um aleatório, por exemplo: -join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_})
JWT_SEGREDO=
JWT_ACESSO_MINUTOS=15
JWT_REFRESH_DIAS=7
JWT_EMISSOR=carshub-api

# ---- Frontend / CORS (11.7) — várias origens separadas por vírgula ----
FRONTEND_URL=http://localhost:5173

# ---- Geocodificação (Google Maps Geocoding API) ----
# OPCIONAL: sem chave, a busca de endereço/coordenadas fica limitada.
GOOGLE_MAPS_API_KEY=
GEOCODIFICACAO_URL_BASE=https://maps.googleapis.com/maps/api/geocode/json
GEOCODIFICACAO_TEMPO_LIMITE_CONEXAO_MS=3000
GEOCODIFICACAO_TEMPO_LIMITE_LEITURA_DIRETA_MS=3000
GEOCODIFICACAO_TEMPO_LIMITE_LEITURA_REVERSA_MS=800
GEOCODIFICACAO_TENTATIVAS_EXTRAS=2
GEOCODIFICACAO_ESPERA_ENTRE_TENTATIVAS_MS=250
GEOCODIFICACAO_FALHAS_PARA_ABRIR_CIRCUITO=5
GEOCODIFICACAO_SEGUNDOS_CIRCUITO_ABERTO=60
GEOCODIFICACAO_LIMITE_MENSAL=999
GEOCODIFICACAO_BLOQUEAR_AO_EXCEDER=false

# ---- Storage S3 (RustFS local / AWS em produção) ----
# STORAGE_S3_ENDPOINT vazio = disco local (pasta uploads/). No Docker,
# o compose sobrepõe com http://rustfs:9000 (rede interna).
# CREDENCIAIS DO STORAGE: defina no .env (nunca aqui). A CHAVE DE ACESSO
# deve ter só letras maiúsculas e dígitos (A-Z, 0-9, sem "/"); use uma
# senha forte e única para a chave secreta.
STORAGE_S3_ENDPOINT=
STORAGE_S3_BUCKET=carshub-uploads
STORAGE_S3_REGIAO=us-east-1
STORAGE_S3_CHAVE_ACESSO=
STORAGE_S3_CHAVE_SECRETA=
STORAGE_S3_URL_BASE=

# ---- Uploads ----
APP_UPLOAD_DIR=uploads

# ---- Prazos dos serviços ----
MINUTOS_EXPIRACAO_PROPOSTA=30
HORAS_EXPIRACAO_SOLICITACAO=3

# ---- Rate limit (11.8) ----
RATE_LIMIT_HABILITADO=true
RATE_LIMIT_JANELA_SEGUNDOS=60
RATE_LIMIT_REQUISICOES_POR_JANELA=120
RATE_LIMIT_LOGIN_POR_MINUTO=10
RATE_LIMIT_REFRESH_POR_MINUTO=30
RATE_LIMIT_CADASTRO_POR_HORA=20

# ---- LGPD (11.11) ----
LGPD_ANONIMIZACAO_HABILITADA=true
LGPD_RETENCAO_COMENTARIOS_DIAS=365
